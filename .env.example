DATABASE_URL=postgresql://localhost:5433/ship2shore
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Optional — enables generated (vs. extractive) answers in `cli.py ask`
ANTHROPIC_API_KEY=

# Shipboard deployment (see README "Shipboard deployment"). Leave as "postgres"
# for shore-side use. Set to "sqlite" on a vessel deployment running from a
# snapshot produced by `cli.py export-sqlite` — no Postgres/network needed then.
STORAGE_BACKEND=postgres
SQLITE_PATH=ship2shore.sqlite3
