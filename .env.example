DATABASE_URL=postgresql://localhost:5433/ship2shore
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Reranks the RRF-fused candidate pool before the final top-k cut — see
# README "How it works". Rarely needs changing.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Truncates rag/pipeline.py's assembled context rather than blindly
# concatenating every passage; not binding at the default top_k=5.
MAX_CONTEXT_CHARS=80000
# Optional — enables generated (vs. extractive) answers in `cli.py ask`
ANTHROPIC_API_KEY=

# Shipboard deployment (see README "Shipboard deployment"). Leave as "postgres"
# for shore-side use. Set to "sqlite" on a vessel deployment running from a
# snapshot produced by `cli.py export-sqlite` — no Postgres/network needed then.
STORAGE_BACKEND=postgres
SQLITE_PATH=ship2shore.sqlite3

# cli.py serve (see README "Web UI") — no auth on this app, so it must stay
# on localhost unless you deliberately opt in to a LAN/vessel-network deploy.
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8020

# cli.py serve-ingest (see README "Ingestion service") — writes to the
# corpus, no auth, same localhost-only-by-default posture as WEBUI_HOST.
INGEST_SERVICE_HOST=127.0.0.1
INGEST_SERVICE_PORT=8030
